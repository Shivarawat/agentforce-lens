PORT=4000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=lens
PG_PASSWORD=lens_secret
PG_DATABASE=agentforce_lens

# Redis
REDIS_URL=redis://localhost:6379

# Salesforce Connected App credentials (one per org, stored in DB after OAuth)
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
SF_CALLBACK_URL=http://localhost:4000/api/auth/callback

# Session secret for server-side token encryption
SESSION_SECRET=change_this_to_a_long_random_string
